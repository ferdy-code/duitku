# --- LLM ---
# Any OpenAI-compatible endpoint (e.g. https://api.openai.com/v1)
LLM_BASE_URL=
LLM_API_KEY=
MODEL_AGENT=claude-sonnet-5-5
MODEL_LIGHT=claude-haiku-5-5
MODEL_VISION=claude-sonnet-5-5
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
MAX_AGENT_STEPS=8

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (R-14)
TELEGRAM_ALLOWED_USER_IDS=
RATE_LIMIT_MESSAGES_PER_MINUTE=20

# --- Database ---
# SQLAlchemy async format (psycopg v3)
DATABASE_URL=postgresql+psycopg://duitku:duitku@localhost:5432/duitku
# libpq format for the LangGraph checkpointer
CHECKPOINT_DATABASE_URL=postgresql://duitku:duitku@localhost:5432/duitku

# --- Memory / embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Cosine thresholds calibrated for intfloat/multilingual-e5-small (T-303, experiments/results/).
# Re-calibrate (experiments/calibrate_memory_threshold.py) if EMBEDDING_MODEL changes.
MEMORY_RECALL_THRESHOLD=0.835
MEMORY_DEDUPE_THRESHOLD=0.985
MEMORY_RECALL_TOP_K=3

# --- App ---
DEFAULT_TIMEZONE=Asia/Jakarta
RECEIPT_DIR=./data/receipts
RECEIPT_RETENTION_DAYS=30
SHORT_TERM_MAX_TOKENS=6000

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=duitku
# false = message content and tool args are redacted from logs/spans (recommended)
LOG_CONTENT=false
LOG_LEVEL=INFO
